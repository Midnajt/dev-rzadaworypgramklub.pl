# rzadowyprogramklub.pl — SPA hash
# Wymaga Apache + mod_rewrite. Katalog public_html.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

RewriteEngine On

# Wymuś HTTPS (wyjątek dla walidacji certyfikatu Let's Encrypt)
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^index\.html$ / [R=301,L]

# Przekierowania starych adresów WordPress na hashe SPA
RewriteRule ^aktualnosci/?$ /#/aktualnosci [R=301,L,NE]
RewriteRule ^faq/?$ /#/faq [R=301,L,NE]
RewriteRule ^regulamin/?$ /#/regulamin [R=301,L,NE]
RewriteRule ^podstawowe-informacje/?$ /#/podstawowe-informacje [R=301,L,NE]
RewriteRule ^do-pobrania/?$ /#/do-pobrania [R=301,L,NE]
RewriteRule ^kontakt/?$ /#/kontakt [R=301,L,NE]

# Istniejące pliki (assety, sitemap, pliki weryfikacyjne) serwuj wprost
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Nieznana ścieżka → widok 404 w SPA
RewriteRule ^ /#/404 [R=302,L,NE]
